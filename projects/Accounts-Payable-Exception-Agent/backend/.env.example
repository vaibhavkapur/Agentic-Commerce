# Copy to backend/.env for local overrides. Never commit the real .env.
# Every value here has a working development default; leave a line out to keep the default.

# --- Persistence -------------------------------------------------------------
# SQLite (default, zero configuration):
# DATABASE_URL=sqlite:///./data/ap.db
# Supabase PostgreSQL (apply supabase/migrations/0001_initial.sql first; needs `uv pip install -e ".[postgres]"`):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Document storage --------------------------------------------------------
# STORAGE_BACKEND=local              # local | supabase
# STORAGE_DIR=./data/storage
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=         # server-side only; never ship to the browser
# SUPABASE_STORAGE_BUCKET=case-documents   # must be a *private* bucket

# --- Authentication ----------------------------------------------------------
# For Supabase Auth set this to the project's JWT secret so the API verifies Supabase-issued tokens.
# AUTH_JWT_SECRET=change-me-to-a-long-random-string
# AUTH_JWT_AUDIENCE=authenticated
# Password-less dev login endpoint (POST /auth/dev-login). Set to false outside local development.
# DEV_LOGIN_ENABLED=true

# --- Approval policy ---------------------------------------------------------
# APPROVAL_POLICY_VERSION=ap-policy-v1
# APPROVAL_TTL_HOURS=72

# --- Agent -------------------------------------------------------------------
# AGENT_RUN_MODE=inline              # inline (run in API process) | worker (python -m app.worker)
# LANGGRAPH_CHECKPOINT_PATH=./data/checkpoints.sqlite
# AGENT_MAX_MODEL_CALLS=6
# AGENT_MAX_TOOL_CALLS=30
# Optional. Without a key the agent uses deterministic templates (the evaluation baseline).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Web ---------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
