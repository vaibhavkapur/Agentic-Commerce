# Copy to frontend/.env.local if the API is not on http://127.0.0.1:8000.
# Only build-time, non-secret values belong here; the browser never holds provider or Supabase service keys.

# Where the Vite dev server proxies /api requests.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Base URL the built bundle calls directly (default "/api", i.e. same origin behind a reverse proxy).
# VITE_API_BASE=/api
